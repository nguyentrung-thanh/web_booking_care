<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit user's information</title>
    <!-- Latest compiled and minified CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">

    <!-- jQuery library -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.slim.min.js"></script>

    <!-- Popper JS -->
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>

    <!-- Latest compiled JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>
    <div class="container">
        <div class="row">
            <div class="col-12 col-md-8 mt-4">
                <form action="/put-crud" method="POST">
                    <!-- Lưu ý: HTML form mặc định chỉ hỗ trợ GET/POST, PUT thường dùng qua thư viện phụ trợ hoặc method-override -->
                    <div class="form-row">
                        <div class="col-12 mt-3"><b>Edit user's information:</b></div>

                        <div class="form-group col-md-6">
                            <label>First name</label>
                            <input type="text" class="form-control" placeholder="First name" name="firstName"
                                value="<%= user.firstName %>" />
                        </div>

                        <div class="form-group col-md-6">
                            <label>Last name</label>
                            <!-- Đã sửa lại lasttName thành lastName cho đúng chính tả -->
                            <input type="text" class="form-control" name="lastName" placeholder="Last name"
                                value="<%= user.lastName %>" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="inputAddress">Address</label>
                        <!-- Đã sửa lại Adress thành Address cho đúng chính tả -->
                        <input type="text" class="form-control" name="address" placeholder="Address"
                            value="<%= user.address %>" />
                    </div>
                    <input name="id" value="<%= user.id %>" type="text" hidden />
                    <button type="submit" class="btn btn-primary">Update</button>
                </form>
            </div>
        </div>
    </div>
</body>

</html>